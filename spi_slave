module spi_slave #(
    parameter integer CLK_FREQ = 100_000_000
)(
    input  wire       clk,
    input  wire       rst,

    // SPI interface
    input  wire       sclk,
    input  wire       cs_n,
    input  wire       mosi,
    output reg        miso,

    // User interface
    input  wire [7:0] tx_data,
    output reg [7:0]  rx_data,

    output reg        busy,
    output reg        done
);

    reg sclk_meta;
    reg sclk_sync;
    reg sclk_prev;

    reg cs_meta;
    reg cs_sync;
    reg cs_prev;      // added: needed for edge detection

    reg mosi_meta;
    reg mosi_sync;

    
    wire sclk_rise;
    wire sclk_fall;
    wire cs_fall;      // added: true only on the clock CS first goes low

    assign sclk_rise = sclk_sync & ~sclk_prev;
    assign sclk_fall = ~sclk_sync & sclk_prev;
    assign cs_fall   = ~cs_sync & cs_prev;

  
    always @(posedge clk or posedge rst) begin

        if (rst) begin

            sclk_meta <= 1'b0;
            sclk_sync <= 1'b0;
            sclk_prev <= 1'b0;

            cs_meta   <= 1'b1;
            cs_sync   <= 1'b1;
            cs_prev   <= 1'b1;

            mosi_meta <= 1'b0;
            mosi_sync <= 1'b0;

        end
        else begin

            // SCLK synchronizer
            sclk_meta <= sclk;
            sclk_sync <= sclk_meta;
            sclk_prev <= sclk_sync;

            // CS synchronizer
            cs_meta <= cs_n;
            cs_sync <= cs_meta;
            cs_prev <= cs_sync;

            // MOSI synchronizer
            mosi_meta <= mosi;
            mosi_sync <= mosi_meta;

        end

    end

   

    localparam [1:0]
        IDLE   = 2'b00,
        ACTIVE = 2'b01,
        DONE   = 2'b10;

    reg [1:0] state;

    

    reg [7:0] rx_shift;
    reg [7:0] tx_shift;

    

    reg [2:0] bit_count;

    

    always @(posedge clk or posedge rst) begin

        if (rst) begin

            state     <= IDLE;

            rx_shift  <= 8'b0;
            tx_shift  <= 8'b0;

            rx_data   <= 8'b0;

            bit_count <= 3'd0;

            miso      <= 1'b0;

            busy      <= 1'b0;
            done      <= 1'b0;

        end
        else begin

            done <= 1'b0;

            case (state)

                
                IDLE: begin

                    busy      <= 1'b0;
                    miso      <= 1'b0;

                    bit_count <= 3'd0;

                    
                    if (cs_fall) begin

                        busy <= 1'b1;

                        
                        tx_shift <= tx_data;

                        
                        rx_shift <= 8'b0;

                       
                        miso <= tx_data[7];

                        state <= ACTIVE;

                    end

                end

                
                ACTIVE: begin

                    // CS released early / transfer aborted
                    if (cs_sync) begin

                        busy  <= 1'b0;
                        miso  <= 1'b0;

                        state <= IDLE;

                    end
                    else begin

                        
                        if (sclk_rise) begin

                            rx_shift <= {rx_shift[6:0], mosi_sync};

                            if (bit_count == 3'd7) begin

                                rx_data <= {rx_shift[6:0], mosi_sync};

                                state <= DONE;

                            end
                            else begin
                                bit_count <= bit_count + 1'b1;
                            end

                        end

                       
                        if (sclk_fall) begin

                            tx_shift <= {tx_shift[6:0], 1'b0};
                            miso     <= tx_shift[6];

                        end

                    end

                end

                
                DONE: begin

                    busy <= 1'b0;
                    done <= 1'b1;
                    miso <= 1'b0;

                    state <= IDLE;

                end

                default: begin
                    state <= IDLE;
                end

            endcase

        end

    end

endmodule
