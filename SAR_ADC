`timescale 1ns / 1ps

module sar_adc #(
parameter N = 8)(
    input  wire         clk,
    input  wire         reset,
    input  wire         start,

   
    input  wire         comp_out,

   
    output reg [N-1:0]  dac_code,

    // Final ADC result
    output reg [N-1:0]  dout,

    // Status signals
    output reg          busy,
    output reg          eoc
);

    

    localparam IDLE    = 2'd0;
    localparam SAMPLE  = 2'd1;
    localparam CONVERT = 2'd2;
    localparam DONE    = 2'd3;

    reg [1:0] state;

    

    reg [N-1:0] sar_reg;


    reg [$clog2(N)-1:0] bit_index;

    

    always @(posedge clk or posedge reset) begin

        if (reset) begin

            state     <= IDLE;

            sar_reg   <= 0;
            dac_code  <= 0;
            dout      <= 0;

            bit_index <= 0;

            busy      <= 0;
            eoc       <= 0;

        end

        else begin

            case (state)

               

                IDLE: begin

                    busy <= 0;
                    eoc  <= 0;

                    if (start) begin

                        state <= SAMPLE;
                        busy  <= 1;

                    end

                end



                SAMPLE: begin

                    
                    sar_reg  <= {1'b1, {(N-1){1'b0}}};

                    
                    dac_code <= {1'b1, {(N-1){1'b0}}};

                    
                    bit_index <= N-1;

                    state <= CONVERT;

                end


                

                CONVERT: begin

              

                    if (comp_out) begin
                        sar_reg[bit_index]  <= 1'b1;
                        dac_code[bit_index] <= 1'b1;
                    end
                    else begin
                        sar_reg[bit_index]  <= 1'b0;
                        dac_code[bit_index] <= 1'b0;
                    end


                    

                    if (bit_index == 0) begin

                        state <= DONE;

                    end

                    else begin

                        
                        bit_index <= bit_index - 1;

                       

                        sar_reg[bit_index-1]  <= 1'b1;
                        dac_code[bit_index-1] <= 1'b1;

                    end

                end



                DONE: begin

                    dout <= sar_reg;

                    busy <= 0;

                    eoc <= 1;

                    state <= IDLE;

                end


                default: begin

                    state <= IDLE;

                end

            endcase

        end

    end

endmodule
